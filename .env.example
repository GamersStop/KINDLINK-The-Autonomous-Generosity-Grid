# ==============================================================================
# KINDLINK: THE AUTONOMOUS GENEROSITY GRID — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and populate with your API credentials and secrets.

# ------------------------------------------------------------------------------
# 1. Runtime & Infrastructure
# ------------------------------------------------------------------------------
MOCK_SERVICES=true
DATABASE_URL=postgresql://kindlink:kindlink_secret_password@db:5432/kindlink_db
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SALT=kindlink_secure_salt_

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Multimodal Decomposition & Vision SOS)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. ElevenLabs Conversational Voice & Emergency TTS
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# ------------------------------------------------------------------------------
# 4. Solana Devnet & Micro-Grant Escrow
# ------------------------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ESCROW_PUBKEY=ComputeBudget111111111111111111111111111111
SOLANA_PAYER_PRIVATE_KEY=your_base58_encoded_solana_devnet_payer_private_key
MISSION_ESCROW_WALLET=ComputeBudget111111111111111111111111111111

# ------------------------------------------------------------------------------
# 5. Global Auditor Dashboard Authentication
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@kindlink.org
ADMIN_PASSWORD=GridAdminSecure2026!

# ------------------------------------------------------------------------------
# 6. Snowflake Cortex Data Warehouse & Macro Analytics
# ------------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_snowflake_account_id
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=KINDLINK_ANALYTICS
SNOWFLAKE_SCHEMA=AUDIT_GRID
